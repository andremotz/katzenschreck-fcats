# Dockerfile for Katzenschreck on NVIDIA Jetson
# Based on ultralytics/ultralytics with JetPack 6 support (Ubuntu 22.04, GLIBC 2.35)

FROM ultralytics/ultralytics:latest-jetson-jetpack6

# Set working directory
WORKDIR /katzenschreck

# Install system dependencies including FFmpeg libraries for OpenCV
RUN apt-get update && apt-get install -y \
    git \
    ffmpeg \
    libavcodec58 \
    libavformat58 \
    libavutil56 \
    libswscale5 \
    libswresample3 \
    && rm -rf /var/lib/apt/lists/*

# Code is taken from the local build context (the checked-out repo), not cloned.
# Use start_jetson_docker.sh to build: it checks for a clean working tree and
# tags/labels the image with the Git commit.

# Copy requirements file
COPY cat_detector/requirements_jetson.txt /katzenschreck/requirements_jetson.txt

# Install Python dependencies
# Note: PyTorch, ultralytics, and opencv are already included in the base image
# Update setuptools first to avoid compatibility issues
RUN pip install --upgrade setuptools wheel

# Install only additional packages needed (without strict version pins)
# Also install monitoring dependencies
RUN pip install --no-cache-dir \
    paho-mqtt \
    psutil \
    fastapi \
    uvicorn[standard] \
    websockets

# Pre-download YOLO11x model for Jetson (before copying code, so code changes don't re-download it)
RUN python3 -c "from ultralytics import YOLO; YOLO('yolo11x.pt')"

# Placeholder config (the real config.txt is mounted at runtime and must not be baked into the image)
RUN echo "# Config will be mounted" > /katzenschreck/config.txt

# Copy trained models directory (if it exists in the build context)
RUN --mount=type=bind,source=.,target=/src \
    (cp -r /src/runs/ /katzenschreck/runs/ 2>/dev/null || mkdir -p /katzenschreck/runs/)

# Create results directory
RUN mkdir -p /katzenschreck/results

# Copy application code
COPY cat_detector/ /katzenschreck/cat_detector/

# Expose monitoring port (default: 8080, configurable via config.txt)
# Note: Port mapping only applies when not using --network host
EXPOSE 8080

# Set environment variable for hardware type
ENV PYTHONUNBUFFERED=1

# GPU optimization environment variables for Jetson Orin Nano with JetPack 6
# Conservative settings for 4-8GB shared memory
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:256,garbage_collection_threshold:0.6

# GPU verification during build (will show warning if no GPU access, that's expected)
RUN python3 -c "\
import torch; \
print('='*60); \
print('PyTorch Version:', torch.__version__); \
print('CUDA Compiled:', torch.version.cuda if hasattr(torch.version, 'cuda') else 'N/A'); \
print('CUDA Available:', torch.cuda.is_available()); \
print('='*60)" 2>&1 || echo "⚠️ GPU check skipped (expected during build without --gpus flag)"

# Healthcheck: Monitor application health via monitoring API
# Checks every 30s, timeout after 10s, 3 retries before unhealthy
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import urllib.request, json, sys, os; port = os.environ.get('MONITORING_PORT', '8080'); response = urllib.request.urlopen(f'http://localhost:{port}/api/status', timeout=5); data = json.loads(response.read()); sys.exit(0 if data.get('is_streaming', False) else 1)" || exit 1

# Record which commit the image was built from (set by start_jetson_docker.sh)
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.revision=${GIT_COMMIT} \
      org.opencontainers.image.source=https://github.com/andremotz/katzenschreck-fcats
ENV KATZENSCHRECK_GIT_COMMIT=${GIT_COMMIT}

# Default command (can be overridden)
CMD ["python3", "-m", "cat_detector.main", "/katzenschreck/results"]

