# Home Assistant access for analysis and debugging (not used by the detector itself).
# Copy to .env and fill in. .env is git-ignored and excluded from the Docker build context.

# Base URL of Home Assistant, e.g. http://homeassistant.local:8123
HA_URL=
# Long-lived access token: HA profile -> Security -> Long-lived access tokens
HA_TOKEN=
# Entity id of the sprinkler / valve triggered on cat detections, e.g. switch.garden_sprinkler
HA_SPRINKLER_ENTITY=
# Optional: id of the automation that reacts to MQTT object_detection/Cat, e.g. automation.katzenschreck
HA_AUTOMATION_ENTITY=
